{
  "name": "granite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "go test ./pkg/server -run ^TestDatabaseE2E$ -count=1 -timeout=15m -v -args -database-e2e",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e:storage": "go test ./pkg/server -run ^TestStorageE2E$ -count=1 -timeout=5m -v -args -storage-e2e"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.15"
    }
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^0.54.0",
    "@tanstack/ai-client": "^0.31.1",
    "@tanstack/ai-openai": "^0.22.6",
    "@tanstack/ai-react": "^0.24.1",
    "@tanstack/highlight": "^0.1.0",
    "@tanstack/markdown": "^0.0.14",
    "@tanstack/query-db-collection": "^1.2.13",
    "@tanstack/react-db": "^0.3.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql-formatter": "^15.8.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
